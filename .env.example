# Clave de Gemini API (Obligatoria para visión multimodal)
# Obtén tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modo de operación del bot:
MODO_FACTURACION=real
PLAYWRIGHT_HEADLESS=true

# Configuración de Correo Electrónico (Para envío autónomo en la nube)
# Opciones recomendadas:
# - iCloud: SMTP_HOST=smtp.mail.me.com | SMTP_PORT=587 | SMTP_USER=tu_correo@icloud.com | SMTP_PASS=tu_app_specific_password
# - Gmail: SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_USER=tu_correo@gmail.com | SMTP_PASS=tu_contraseña_de_aplicacion
# - SendGrid / Resend / AWS SES:
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mochoad@icloud.com
SMTP_PASS=

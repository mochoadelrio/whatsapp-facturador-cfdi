GEMINI_API_KEY=AQ.Ab8RN6I3cDkqO1pi4-ByiHWR8yvWowyaJzCGKqaDts9Awg7jMQ

# Modo de operación del motor de facturación:
# - "hibrido" (Recomendado): Intenta navegar al portal del ticket con Playwright + IA y además genera el CFDI PDF/XML
# - "real": Solo intenta facturar en el portal real del ticket con Playwright
# - "demo": Genera inmediatamente un PDF y XML CFDI 4.0 con los datos reales extraídos de la foto del ticket
MODO_FACTURACION=hibrido

# Mostrar el navegador de Playwright mientras llena el portal (false para ver cómo trabaja el bot, true para modo invisible)
PLAYWRIGHT_HEADLESS=false

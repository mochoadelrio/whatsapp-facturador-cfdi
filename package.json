  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "playwright": "^1.51.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode-terminal": "^0.12.2",
